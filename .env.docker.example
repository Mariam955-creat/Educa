# === educa — variables pour le déploiement Docker (modèle) ===
# Copier en `.env` (à la racine) — Docker Compose le lit automatiquement.
# NE PAS versionner le vrai `.env`.

# --- Web (port publié de l'application) ---
WEB_PORT=8080

# --- Profil backend ---
# prod : schéma migré, pas de données de démo, messages d'erreur masqués.
# dev  : + comptes et cours de démonstration seedés (DevDataInitializer).
BACKEND_PROFILE=prod

# --- PostgreSQL (conteneur `db`) ---
POSTGRES_DB=educa
POSTGRES_USER=educa
POSTGRES_PASSWORD=change-me-strong

# --- JWT (chaîne aléatoire >= 64 caractères) ---
JWT_SECRET=change-me-with-a-long-random-secret-at-least-64-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- CORS : origine publique du frontend (utile si l'API est appelée directement) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Upload ---
STORAGE_MAX_FILE_SIZE_MB=200

# --- IA (chatbot) — laisser AI_ENABLED=false sans clé réelle : repli propre ---
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=15000
AI_MAX_CONTEXT_CHARS=4000
