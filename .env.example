# === educa — variables d'environnement (modèle) ===
# Copier ce fichier en `.env` et renseigner les vraies valeurs.
# `.env` n'est JAMAIS versionné (voir .gitignore).

# --- Serveur ---
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- PostgreSQL (installé en local, administré avec pgAdmin) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=educa
POSTGRES_TEST_DB=educa_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- JWT ---
# Générer une chaîne aléatoire longue (>= 64 caractères).
JWT_SECRET=change-me-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- Stockage fichiers (dev : système de fichiers local) ---
STORAGE_LOCAL_PATH=./var/storage
STORAGE_MAX_FILE_SIZE_MB=200

# --- IA (API Claude / Anthropic) ---
AI_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=15000
AI_MAX_CONTEXT_CHARS=4000

# --- Paiements (achat individuel de cours, prix fixé par le formateur) ---
# Origine où l'API est joignable par les prestataires (webhooks). En dev, laisser :8081.
WEBHOOK_BASE_URL=http://localhost:8081

# Europe — Stripe (clé de test sk_test_... ; stripe listen --forward-to
# localhost:8081/api/v1/payments/webhooks/stripe pour recevoir les webhooks en dev)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Afrique — Orange Money (intégration directe, compte marchand Orange Developer, un pays donné ;
# le notif_url doit être joignable publiquement depuis leurs serveurs, prévoir un tunnel en dev)
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY=civ
ORANGE_MONEY_CURRENCY=XOF
